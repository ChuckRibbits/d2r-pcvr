set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(MINGW_ROOT "$ENV{MINGW_ROOT}" CACHE PATH "Extracted mingw /usr tree")
set(CLANG_ROOT "$ENV{CLANG_ROOT}" CACHE PATH "Clang bin directory")
if(NOT MINGW_ROOT OR NOT CLANG_ROOT)
  message(FATAL_ERROR "Set MINGW_ROOT and CLANG_ROOT before configuring")
endif()
set(CMAKE_C_COMPILER "${CLANG_ROOT}/clang")
set(CMAKE_CXX_COMPILER "${CLANG_ROOT}/clang++")
set(CMAKE_C_COMPILER_TARGET x86_64-w64-windows-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-w64-windows-gnu)
set(CMAKE_RC_COMPILER "${MINGW_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_SYSROOT "${MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_C_FLAGS_INIT "-fms-extensions")
set(CMAKE_CXX_FLAGS_INIT "-fms-extensions -isystem ${MINGW_ROOT}/lib/gcc/x86_64-w64-mingw32/13-posix/include/c++ -isystem ${MINGW_ROOT}/lib/gcc/x86_64-w64-mingw32/13-posix/include/c++/x86_64-w64-mingw32 -isystem ${MINGW_ROOT}/lib/gcc/x86_64-w64-mingw32/13-posix/include/c++/backward")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${MINGW_ROOT}/lib/gcc/x86_64-w64-mingw32/13-posix -static-libgcc -static-libstdc++")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
